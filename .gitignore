# Плоские копии файлов для Releases — пересоздаются генератором.
upload/

# Бинарники в git не храним: каждое обновление модов навсегда осталось бы
# в истории и репозиторий за год распух бы до гигабайтов. Все версии jar-ов
# лежат в Releases — это и есть их архив, git там не нужен.
pack/mods/*.jar
pack/resourcepacks/*.zip
pack/shaderpacks/*.zip

# Машинно-зависимые файлы: привязаны к железу конкретного игрока,
# не раздаются и в репозитории не хранятся.
pack/config/sodium-fingerprint.json
pack/config/etf_warnings.json
